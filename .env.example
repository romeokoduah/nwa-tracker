# ── Server (Vercel env var) ──────────────────────────────────────────────
# Neon pooled connection string. Get it from the Neon dashboard:
#   Project → Connection Details → "Pooled connection".
# Set this in Vercel: Project → Settings → Environment Variables (Production
# + Preview). For local `vercel dev`, also put it in nwa-tracker/.env
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# ── Client (optional, build-time) ────────────────────────────────────────
# Leave empty in production: the frontend and the API are the same origin on
# Vercel. Only set this when running the plain Vite dev server (port 5173)
# against an already-deployed API, e.g. https://your-app.vercel.app
VITE_API_BASE=
